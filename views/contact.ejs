<%- include('partials/header') %>
<section class="page-section narrow">
  <h1>Contact</h1>
  <% if (errors && errors.length) { %>
    <ul class="error-list">
      <% errors.forEach(function(e) { %>
        <li><%= e.msg %></li>
      <% }); %>
    </ul>
  <% } %>
  <form method="POST" action="/contact" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label for="name">Nom</label>
    <input type="text" id="name" name="name" value="<%= values.name || '' %>" maxlength="100" required>

    <label for="email">E-mail</label>
    <input type="email" id="email" name="email" value="<%= values.email || '' %>" maxlength="200" required>

    <label for="message">Message</label>
    <textarea id="message" name="message" maxlength="2000" rows="6" required><%= values.message || '' %></textarea>

    <button type="submit" class="button">Envoyer</button>
  </form>
</section>
<%- include('partials/footer') %>
