<%- include('../partials/header') %>
<div class="page-header">
  <h1><%= chantier.titre %> <span class="badge badge-<%= chantier.statut %>"><%= STATUT_LABELS[chantier.statut] %></span></h1>
  <div class="page-header-actions">
    <a class="button button-secondary" href="/chantiers/<%= chantier.id %>/edit">Modifier</a>
    <form method="POST" action="/chantiers/<%= chantier.id %>/delete" class="inline-form" onsubmit="return confirm('Supprimer ce chantier ?');">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="button button-danger">Supprimer</button>
    </form>
  </div>
</div>

<section class="card">
  <p><strong>Client :</strong> <a href="/clients/<%= chantier.client_id %>"><%= chantier.client_nom %></a></p>
  <% if (chantier.description) { %><p><strong>Description :</strong> <%= chantier.description %></p><% } %>
  <p><strong>Adresse :</strong> <%= chantier.adresse || '—' %></p>
  <p><strong>Début :</strong> <%= chantier.date_debut || '—' %> · <strong>Fin prévue :</strong> <%= chantier.date_fin_prevue || '—' %> · <strong>Fin réelle :</strong> <%= chantier.date_fin_reelle || '—' %></p>
</section>

<section class="card">
  <div class="page-header">
    <h2>Devis (<%= devis.length %>)</h2>
    <a class="button button-small" href="/devis/new?client_id=<%= chantier.client_id %>&chantier_id=<%= chantier.id %>">+ Nouveau devis</a>
  </div>
  <% if (!devis.length) { %>
    <p class="muted">Aucun devis.</p>
  <% } else { %>
    <ul class="link-list">
      <% devis.forEach(function(d) { %>
        <li><a href="/devis/<%= d.id %>">DEV-<%= String(d.id).padStart(4, '0') %></a>
          — <%= d.total_ttc.toFixed(2) %> € <span class="badge badge-<%= d.statut %>"><%= d.statut %></span></li>
      <% }); %>
    </ul>
  <% } %>
</section>

<section class="card">
  <div class="page-header">
    <h2>Factures (<%= factures.length %>)</h2>
    <a class="button button-small" href="/factures/new?client_id=<%= chantier.client_id %>&chantier_id=<%= chantier.id %>">+ Nouvelle facture</a>
  </div>
  <% if (!factures.length) { %>
    <p class="muted">Aucune facture.</p>
  <% } else { %>
    <ul class="link-list">
      <% factures.forEach(function(f) { %>
        <li><a href="/factures/<%= f.id %>">FAC-<%= String(f.id).padStart(4, '0') %></a>
          — <%= f.total_ttc.toFixed(2) %> € <span class="badge badge-<%= f.statut %>"><%= f.statut %></span></li>
      <% }); %>
    </ul>
  <% } %>
</section>
<%- include('../partials/footer') %>
