# Copiez ce fichier en .env et remplissez des valeurs réelles.
# Ne jamais committer le fichier .env final.

NODE_ENV=development
PORT=3000

# Doit être une chaîne longue et aléatoire (ex: `openssl rand -hex 32`)
SESSION_SECRET=change-me-to-a-long-random-string

# Mettre à 1 si l'app tourne derrière un reverse proxy / load balancer (Nginx, etc.)
TRUST_PROXY=0

# Compte administrateur initial, créé par `npm run seed`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Chemin du fichier de base de données SQLite
DATABASE_PATH=./data/app.sqlite
